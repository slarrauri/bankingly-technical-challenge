# ==============================================================================
# Environment Configuration - AML Alert Investigation Copilot
# ==============================================================================

# Puerto público en el host VPS
HOST_PORT=8081

# Proveedor LLM (mock, openai, gemini, etc.)
LLM_PROVIDER=mock

# Base de datos (por defecto SQLite persistente en volumen Docker)
DATABASE_URL=sqlite:////app/storage/aml_copilot.db

# API Keys (opcional según el LLM_PROVIDER seleccionado)
OPENAI_API_KEY=
GEMINI_API_KEY=
